# URL HTTPS de production. En développement web, localhost:8099 est utilisé.
# Dans l’émulateur Android, la valeur par défaut est http://10.0.2.2:8099.
VITE_API_URL=https://api.example.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PODMIX_ALLOWED_ORIGINS=https://podmix.example.com
PODMIX_HOST=127.0.0.1
PODMIX_PORT=8099
PODMIX_TRACKLIST_SOURCES=mixesdb,1001tracklists
PODMIX_WEB_TIMESTAMP_TIMEOUT=420
PODMIX_SHARE_PUBLIC_BASE=https://podmix.example.com/s
PODMIX_SHARE_TTL=2592000
PODMIX_SHARE_PER_HOUR=20
# Jeton AudD : reste côté serveur, jamais dans l'APK.
PODMIX_AUDD_API_TOKEN=
PODMIX_MUSIC_RECOGNITION_PER_HOUR=20
# Dernier recours après échec RSS, YouTube et recherche Web : analyse audio
# locale des mixes techno/trance à tracklist connue.
PODMIX_AUDIO_FALLBACK=1
# Active automatiquement le décodage/consolidation IA des résultats Web.
# Mettre PODMIX_OPENAI_TIMESTAMPING=0 pour forcer le parseur local uniquement.
NOUS_PORTAL_API=
PODMIX_AI_PROVIDER=nous
PODMIX_OPENAI_TIMESTAMPING=auto
PODMIX_NOUS_MODEL=Hermes-4-70B
