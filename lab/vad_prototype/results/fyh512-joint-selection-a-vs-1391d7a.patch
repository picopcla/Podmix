+def _landmark_corrections_from_presences(
+    presences: dict[int, LandmarkPresence],
+    reference_count: int,
+    audio_candidates: list[tuple[float, float]],
+) -> tuple[dict[int, float], dict[int, str]]:
+    corrections: dict[int, float] = {}
+    confidence: dict[int, str] = {}
+    for incoming in range(2, reference_count + 1):
+        outgoing_presence = presences.get(incoming - 1)
+        incoming_presence = presences.get(incoming)
+        if outgoing_presence is None or incoming_presence is None:
+            continue
+        left, right = outgoing_presence.end, incoming_presence.start
+        midpoint = (left + right) / 2
+        position = midpoint
+        gap = right - left
+        if gap > 90.0:
+            local = [item for item in audio_candidates if left <= item[0] <= right]
+            if local:
+                nearest = min(local, key=lambda item: abs(item[0] - midpoint))
+                if abs(nearest[0] - midpoint) <= 30.0:
+                    position = nearest[0]
+        corrections[incoming - 1] = round(position, 2)
+        confidence[incoming - 1] = (
+            "high" if left >= right or abs(gap) <= 90.0
+            else "medium" if gap <= 180.0
+            else "low"
+        )
+    return corrections, confidence
+
+
+def select_joint_landmarks_and_voice(
+    candidate_sets: list[list[LandmarkCandidate]],
+    candidate_presences: dict[LandmarkCandidate, LandmarkPresence | None],
+    voice_candidates: list[BoundaryAnchor],
+    novelty: np.ndarray,
+    duration: float,
+    audio_candidates: list[tuple[float, float]],
+) -> tuple[dict[int, LandmarkCandidate], dict[int, LandmarkPresence],
+           dict[int, float], dict[int, str], dict[int, BoundaryAnchor], dict]:
+    """Sélection conjointe figée, exhaustive sur les annonces candidates.
+
+    Priorités: (1) nombre de présences landmarks fiables, puis (2) somme
+    ``log1p(score_landmark) + confiance_voix``, puis (3) nombre d'annonces.
+    Ainsi une annonce ne remplace jamais une couverture landmark plus longue,
+    mais peut départager deux chaînes de même couverture. Chaque ensemble est
+    finalement soumis au DP de production, avec ses vrais couloirs et novelty.
+    """
+    ordered_voice = sorted(
+        voice_candidates,
+        key=lambda item: (item.track_index, item.time_seconds, item.detection_id),
+    )
+    alternatives: list[dict] = []
+    feasible: list[tuple[tuple, dict[int, LandmarkCandidate], dict[int, LandmarkPresence],
+                         dict[int, float], dict[int, str], dict[int, BoundaryAnchor]]] = []
+    for mask in range(1 << len(ordered_voice)):
+        subset = [ordered_voice[index] for index in range(len(ordered_voice)) if mask & (1 << index)]
+        anchors = {anchor.track_index: anchor for anchor in subset}
+        ids = [anchor.detection_id for anchor in subset]
+        row: dict = {"voice_detection_ids": ids, "decision": "rejected"}
+        if len(anchors) != len(subset):
+            row["reason"] = "duplicate_track_anchor"
+            alternatives.append(row)
+            continue
+        by_track = sorted(subset, key=lambda item: item.track_index)
+        if any(left.time_seconds >= right.time_seconds for left, right in zip(by_track, by_track[1:])):
+            row["reason"] = "anchor_order_conflict"
+            alternatives.append(row)
+            continue
+
+        filtered_sets: list[list[LandmarkCandidate]] = []
+        for candidates in candidate_sets:
+            compatible: list[LandmarkCandidate] = []
+            for candidate in candidates:
+                presence = candidate_presences.get(candidate)
+                anchor = anchors.get(candidate.track - 1)
+                if presence is not None and anchor is not None:
+                    musical_start = max(0.0, presence.anchor - DEEZER_PREVIEW_OFFSET_SECONDS)
+                    if abs(musical_start - anchor.time_seconds) > VOICE_PRESENCE_TOLERANCE_SECONDS:
+                        continue
+                compatible.append(candidate)
+            filtered_sets.append(compatible)
+        chosen = select_ordered_landmarks(filtered_sets)
+        presences = {
+            track: presence
+            for track, candidate in chosen.items()
+            if (presence := candidate_presences.get(candidate)) is not None
+        }
+        corrections, confidence = _landmark_corrections_from_presences(
+            presences, len(candidate_sets), audio_candidates,
+        )
+        conflict = next((
+            "adjacent_presence_conflict"
+            for anchor in subset
+            if anchor.track_index in corrections
+            and abs(corrections[anchor.track_index] - anchor.time_seconds) > VOICE_PRESENCE_TOLERANCE_SECONDS
+        ), None)
+        if conflict is not None:
+            row["reason"] = conflict
+            alternatives.append(row)
+            continue
+        try:
+            detect_constrained_transitions(
+                novelty, len(candidate_sets), duration, presences, anchors,
+            )
+        except AudioFallbackError as error:
+            if str(error) not in {
+                "Ancres audio incompatibles avec une suite de coupes cohérente",
+                "Optimisation audio contrainte incomplète",
+            }:
+                raise
+            row["reason"] = "optimizer_constraint_conflict"
+            alternatives.append(row)
+            continue
+        landmark_utility = sum(math.log1p(item.score) for item in presences.values())
+        voice_utility = sum(anchor.confidence for anchor in subset)
+        stable_identity = tuple(
+            (item.track, round(item.anchor, 3), item.reference, round(item.speed, 4))
+            for item in sorted(chosen.values(), key=lambda value: value.track)
+        )
+        objective = (
+            len(presences), round(landmark_utility + voice_utility, 8),
+            len(subset), tuple(reversed(sorted(ids))), stable_identity,
+        )
+        row.update({
+            "decision": "feasible",
+            "reason": None,
+            "landmark_presence_count": len(presences),
+            "landmark_utility": round(landmark_utility, 8),
+            "voice_count": len(subset),
+            "voice_utility": round(voice_utility, 8),
+            "chosen_landmarks": [
+                {"track": item.track, "reference": item.reference, "anchor": item.anchor,
+                 "speed": item.speed, "score": item.score, "votes": item.votes}
+                for item in sorted(chosen.values(), key=lambda value: value.track)
+            ],
+        })
+        alternatives.append(row)
+        feasible.append((objective, chosen, presences, corrections, confidence, anchors))
+    if not feasible:
+        raise AudioFallbackError("Aucun ensemble conjoint landmarks/voix faisable")
+    selected = max(feasible, key=lambda item: item[0])
+    selected_ids = sorted(anchor.detection_id for anchor in selected[5].values())
+    trace = {
+        "objective": {
+            "priority_1": "maximize_reliable_landmark_presence_count",
+            "priority_2": "maximize_sum_log1p_landmark_score_plus_voice_confidence",
+            "priority_3": "maximize_voice_anchor_count",
+            "tie_break": "stable_candidate_identity_independent_of_input_order",
+            "feasibility": "production_detect_constrained_transitions_same_novelty_corridors_and_dp",
+        },
+        "alternatives_examined": alternatives,
+        "selected_voice_detection_ids": selected_ids,
+        "candidate_order_invariant": True,
+    }
+    return selected[1], selected[2], selected[3], selected[4], selected[5], trace
+
